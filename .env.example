# Copia este archivo como `.env` (gitignorado) y rellena los valores.
# En Vercel, las mismas claves van en Settings -> Environment Variables.

# ---- Fuentes de certificados (ya existentes) ----
EIN_USUARIO=
EIN_PASSWORD=
DRIVE_API_KEY=
DRIVE_FOLDER_ID=
# Respaldo cuando JOMISER no trae el certificado de un RRCC: carpetas de Drive
# con un PDF por certificado, nombrado <DNI 8 digitos>_<CODIGO>_<AAAA-MM-DD>_<APELLIDOS NOMBRES>.pdf
# (p. ej. 46041028_TA_2026-03-20_ANLAS JANAMPA ELIO YODY.pdf). Ids o URLs de carpeta
# separados por comas; deben estar compartidas como "cualquiera con el enlace: lector".
DRIVE_CERT_FOLDERS=

# Certificados de induccion: carpeta de Drive (id o URL) con un PDF por persona,
# nombrado <DNI>_<APELLIDOS NOMBRES>.pdf, con o sin subcarpetas por anio
# (REINDUCCION/2026/...). Es lo que muestra el panel CERTIFICADOS INDUCCION.
# Si se deja vacia se usa DRIVE_FOLDER_ID, la carpeta unica de antes.
DRIVE_INDUCCION_FOLDER=

# ---- Base en Google Sheets + salidas en Drive ----
# Alternativa recomendada: URL /exec del Web App de Google Apps Script.
# Con esta sola variable NO se usan GOOGLE_SA_EMAIL ni GOOGLE_SA_PRIVATE_KEY.
# Copia el archivo apps-script/Code.gs en Apps Script, configura sus Script
# Properties y despliegalo como Web App. Ver README.
APPS_SCRIPT_URL=
# Opcional: mismo secreto guardado como RRCC_TOKEN en Script Properties.
APPS_SCRIPT_TOKEN=
# client_email del JSON de la cuenta de servicio
GOOGLE_SA_EMAIL=
# private_key del mismo JSON. En una sola linea y con los saltos escapados
# como \n; entre comillas dobles. Ejemplo:
#   GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_SA_PRIVATE_KEY=
# Alternativa a las dos anteriores: el JSON completo en una sola variable
# GOOGLE_SA_JSON=

# id del Spreadsheet `DATA` que esta dentro de la carpeta RRCC
# (el segmento tras /d/ en su URL). Si se deja vacio, la app lo busca dentro
# de DRIVE_RRCC_FOLDER_ID: util porque en un id de Drive la "l" minuscula y
# la "I" mayuscula se dibujan igual y copiarlo mal da un error confuso.
SHEET_ID=

# id de la carpeta `RRCC` de Drive (el segmento tras /folders/ en su URL).
# Dentro tiene que haber una subcarpeta `DATA` (salidas por persona) y otra
# `FOTOS` (fotos del personal): la app las encuentra por nombre.
DRIVE_RRCC_FOLDER_ID=

# Opcionales: solo si esas subcarpetas se llaman de otro modo o se quiere
# apuntar a carpetas concretas sin pasar por la raiz.
# DRIVE_OUTPUT_FOLDER_ID=
# DRIVE_FOTOS_FOLDER_ID=

# Opcionales: la hoja de personal y donde empieza.
# En `DATA` la cabecera esta en la fila 3 y los datos en la 4. El nombre de
# la pestana se compara sin distinguir espacios de guiones bajos, asi que
# La estructura oficial usa BD_AESA. El codigo aun acepta BD AESA por
# compatibilidad con libros anteriores.
# SHEET_HOJA_PERSONAL=BD_AESA
# SHEET_FILA_CABECERA=3
# SHEET_FILA_DATOS=4
